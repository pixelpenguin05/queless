rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Canteen Menu Items
    match /menuItems/{itemId} {
      // Any student or visitor can read the menu
      allow read: if true;
      // Only canteen administrators / kitchen staff can add, edit, or delete dishes
      allow write: if isAdmin();
    }

    // Canteen Orders
    match /orders/{orderId} {
      // Students can only read their own orders; admins can read all orders
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      
      // Students can create orders for themselves with valid non-negative items and totals
      allow create: if isAuthenticated() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.total > 0;

      // Only admins/kitchen staff can update order statuses (Accepted, Preparing, Ready, Completed)
      // Students can only cancel if still pending
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.studentId == request.auth.uid && 
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled'
      );

      // Deletion is restricted to canteen managers
      allow delete: if isAdmin();
    }
  }
}
