rules_version = '2';

// DEMO RULES: anyone with the app can read and write these three collections.
// Fine for a classroom demo; do not use for a real business with real data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurants/{id} {
      allow read, create: if true;
    }
    match /menuItems/{id} {
      allow read, write: if true;
    }
    match /orders/{id} {
      allow read, create, update: if true;
    }
  }
}
